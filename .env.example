# --- LLM (OpenRouter). Default model: meta-llama/llama-3.1-8b-instruct
OPENROUTER_API_KEY=
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# --- Telegram digest (user StringSession via Telethon). Leave blank to skip.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
# "me" = your Saved Messages; or a chat id / @username
TELEGRAM_CHAT=me

# --- Optional sources: leave blank to skip
YOUTUBE_API_KEY=
GITHUB_TOKEN=
